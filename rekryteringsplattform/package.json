{
  "name": "rekryteringsplattform",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "dotenv -e .env.local -e .env.test.local -- playwright test",
    "test:e2e:ui": "dotenv -e .env.local -e .env.test.local -- playwright test --ui",
    "test:e2e:install": "playwright install chromium",
    "test:e2e:setup": "dotenv -e .env.local -e .env.test.local -- tsx e2e/setup-test-user.ts",
    "test:smoke": "dotenv -e .env.local -e .env.test.local -- playwright test e2e/smoke.spec.ts",
    "test:smoke:setup": "dotenv -e .env.local -e .env.test.local -- tsx e2e/setup-test-user.ts && dotenv -e .env.local -e .env.test.local -- tsx e2e/setup-test-recruiter.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.66.0",
    "@hookform/resolvers": "^5.2.2",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@sentry/nextjs": "^10.53.1",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.96.0",
    "@tiptap/pm": "^3.22.3",
    "@tiptap/react": "^3.22.3",
    "@tiptap/starter-kit": "^3.22.3",
    "@types/sanitize-html": "^2.16.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.34.0",
    "lucide-react": "^0.563.0",
    "next": "16.1.6",
    "nodemailer": "^8.0.7",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-hook-form": "^7.71.1",
    "react-markdown": "^9.1.0",
    "remark-gfm": "^4.0.1",
