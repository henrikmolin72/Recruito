# Copy to .env.test.local and fill in real test-account credentials.
# Used by Playwright e2e suite. Never commit .env.test.local.

# Where the running app lives. Default: http://localhost:3000.
# For local dev: leave empty (defaults to localhost:3000).
# For staging: set to https://staging.recruito.example
E2E_BASE_URL=http://localhost:3000

# A company-role test account
E2E_COMPANY_EMAIL=
E2E_COMPANY_PASSWORD=

# An admin-role test account
E2E_ADMIN_EMAIL=
E2E_ADMIN_PASSWORD=

# A recruiter-role test account (needed for candidate-apply smoke test)
E2E_RECRUITER_EMAIL=
E2E_RECRUITER_PASSWORD=

# Production-safety guards — prevent e2e suite from running against prod.
# E2E_SUPABASE_PROJECT_REF: the ref of your STAGING project (not prod).
# E2E_ALLOW_PRODUCTION: leave UNSET in all environments. Only set to "true"
# if you intentionally want the suite to run against production (dangerous).
E2E_SUPABASE_PROJECT_REF=
# E2E_ALLOW_PRODUCTION=true  # DO NOT SET — here for documentation only
