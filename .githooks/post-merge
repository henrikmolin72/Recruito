#!/bin/sh
# Recruito vault anti-drift hook — fires after `git merge` / `git pull` (incl. fast-forward).
# Keeps the Obsidian vault from silently drifting behind the code:
#   1. Appends the newly-merged commits to Work-Log/merge-log.md (pure shell, no LLM).
#   2. Flags the dep-graph stale if app code changed, with the exact refresh command.
# It never blocks a merge and never touches code. Disable: export RECRUITO_NO_VAULT_HOOK=1
#
# The semantic dep-graph refresh itself needs the LLM (the /graphify skill), so this hook
# only *flags* it — run `/graphify . --update --obsidian --obsidian-dir .` when you see the flag.

[ -n "$RECRUITO_NO_VAULT_HOOK" ] && exit 0

ROOT="$(git rev-parse --show-toplevel 2>/dev/null)" || exit 0
# Only the primary repo — skip the throwaway worktrees under .claude/.
case "$ROOT" in */.claude/worktrees/*) exit 0 ;; esac

RANGE="ORIG_HEAD..HEAD"
COMMITS="$(git log --no-merges --pretty='- %h %s' "$RANGE" 2>/dev/null)"
[ -z "$COMMITS" ] && exit 0   # nothing new (e.g. already up to date)

DATE="$(date +%Y-%m-%d)"
LOG="$ROOT/Work-Log/merge-log.md"
if [ ! -f "$LOG" ]; then
  printf '# Recruito Merge Log\n\nAuto-appended by `.githooks/post-merge` on every merge. Fold the\nnotable lines into a dated milestone summary periodically, then trim.\n' > "$LOG"
fi
printf '\n## %s\n%s\n' "$DATE" "$COMMITS" >> "$LOG"

# Stale-flag the dep graph when app source changed.
if git diff --name-only "$RANGE" 2>/dev/null | grep -q '^rekryteringsplattform/src/'; then
  mkdir -p "$ROOT/graphify-out" 2>/dev/null
  printf 'stale since %s — refresh: `graphify update .` (quick, code) or /graphify --update (full, incl. notes)\n' "$DATE" > "$ROOT/graphify-out/.stale" 2>/dev/null
  echo "[vault] dep-graph flagged stale (app code changed) — run: graphify update ." 1>&2
fi
exit 0
