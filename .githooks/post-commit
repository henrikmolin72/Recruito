#!/bin/bash
# Refresh graphify dep graph after every commit (background, non-blocking)
ROOT="$(git rev-parse --show-toplevel)"
GRAPHIFY=$(which graphify 2>/dev/null)
if [ -n "$GRAPHIFY" ]; then
  # Correct CLI syntax is `graphify update <path>` — the old `graphify . --update`
  # was rejected as "unknown command '.'" and silently no-op'd (hence the stale graph).
  (cd "$ROOT" && graphify update "$ROOT" >/dev/null 2>&1) &
fi
