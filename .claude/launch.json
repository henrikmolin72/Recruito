{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "Next.js Dev Server",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "rekryteringsplattform"
    },
    {
      "name": "local-stack-dev",
      "runtimeExecutable": "npx",
      "runtimeArgs": ["dotenv", "-e", ".env.localstack", "--", "next", "dev"],
      "port": 3000,
      "autoPort": true,
      "cwd": "rekryteringsplattform"
    },
    {
      "name": "static-preview",
      "runtimeExecutable": "python3",
      "runtimeArgs": ["-m", "http.server", "8137"],
      "port": 8137
    }
  ]
}
